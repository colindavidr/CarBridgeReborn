#!/bin/sh
# CarBridgeReborn postinst - FULLY non-blocking. dpkg waits on this script's stdout/stderr pipe, so ANY
# child that keeps that pipe open wedges dpkg at "Setting up ..." (-> the recurring dpkg lock). So ALL
# work runs in one setsid-detached subshell with stdin/stdout/stderr redirected to /dev/null, and the
# script returns immediately. Nothing synchronous; nothing can hold dpkg's pipe.
_bg='
  /var/jb/usr/bin/cbr-refresh-prefs || /usr/bin/cbr-refresh-prefs || true
  INJ=/var/jb/usr/libexec/cbr-autoinject; [ -x "$INJ" ] || INJ=/usr/libexec/cbr-autoinject
  [ -x "$INJ" ] && "$INJ" --delay 20 || true
  LCTL=/var/jb/bin/launchctl; [ -x "$LCTL" ] || LCTL=/bin/launchctl
  PL=/var/jb/Library/LaunchDaemons/com.carbridgereborn.autoinject.plist
  [ -f "$PL" ] && [ -x "$LCTL" ] && "$LCTL" load -w "$PL" || true
'
if command -v setsid >/dev/null 2>&1; then
  setsid /bin/sh -c "$_bg" </dev/null >/dev/null 2>&1 &
else
  /bin/sh -c "$_bg" </dev/null >/dev/null 2>&1 &
fi
echo "[CBR] Installed. Background setup (prefs + auto-inject ~20s) running detached."
exit 0
